            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterBloggerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "age": {
