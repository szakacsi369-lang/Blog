            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UpdateBloggerDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "password": {
            "type": "string"
          }
        }
