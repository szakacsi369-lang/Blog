{
  "openapi": "3.1.1",
  "info": {
    "title": "BlogApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7012"
    },
    {
      "url": "http://localhost:5173"
    }
  ],
  "paths": {
